{
  "name": "jyterencekim.github.io",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "description": "Personal Astro blog for JY Terence Kim.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build && pagefind --site dist --force-language ko && rm -rf public/pagefind && cp -r dist/pagefind public/",
