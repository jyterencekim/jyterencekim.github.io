---
export interface Props {
  tag: string;
  tagName: string;
  size?: "sm" | "lg";
}

const { tag, tagName, size = "sm" } = Astro.props;
---

<li
  class:list={[
    "group inline-block group-hover:cursor-pointer",
    size === "sm" ? "my-1 underline-offset-4" : "mx-1 my-3 underline-offset-8",
  ]}
>
  <span
    transition:name={tag}
    class:list={[
      "pe-2 text-lg group-hover:text-accent",
      { "text-sm": size === "sm" },
    ]}
  >
    <span class="opacity-80">#</span>&nbsp;<span>{tagName}</span>
  </span>
</li>
